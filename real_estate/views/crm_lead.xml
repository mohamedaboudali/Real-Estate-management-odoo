<odoo>

    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="property_type"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">sales man</attribute>
            </xpath>            
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Expected Date</attribute>
                <attribute name="required">True</attribute>
            </xpath>
            <header>
                <button name="update_description" type="object" string="Update Description" class="btn-primary"/>
                <button name="%(real_estate.create_tenant_wizard_action)d" type="action" string="Create Tenant" class="btn-primary"/>
            </header> 
        </field>
    </record>

</odoo>
