<odoo>
<template id="portal_my_payment" name="Tenant Portal - My Payments">
        <t t-call="portal.portal_layout">
            <div class="container mt16 o_portal_portlets">
                <div class="row">
                    <div class="col-12">
                        <nav class="breadcrumb" aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                                <li class="breadcrumb-item active" aria-current="page">My Payments</li>
                            </ol>
                        </nav>
                        <h1 class="mb16">My Payments</h1>
                        <t t-if="tenant">
                            <p>
                                Hello <strong><t t-esc="tenant.name"/></strong>. Below are the payments linked to your tenant account.
                            </p>
                        </t>
                        <t t-else="">
                            <div class="alert alert-warning" role="alert">
                                No tenant record is linked to your user account. Please contact your property manager to enable portal lease access.
                            </div>
                        </t>
                    </div>
                </div>
                <t t-if="payment">
                    <div class="row">
                        <t t-foreach="payment" t-as="payment">
                            <div class="col-md-6 mb16">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title mb-2">
                                            <t t-esc="payment.property_id.name or payment.name"/>
                                        </h5>
                                        <p class="text-muted mb-2">
                                            <strong>Payment:</strong> <t t-esc="payment.name"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Lease Name:</strong>
                                            <t t-esc="payment.property_id.lease_ids or 'N/A'"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Due Date:</strong>
                                            <t t-esc="payment.due_date"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Amount:</strong>
                                            <t t-esc="payment.amount"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Late Fees:</strong>
                                            <t t-esc="payment.late_fee or '—'"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>State:</strong>
                                            <t t-esc="payment.state or '—'"/>
                                        </p>
                                        <t t-if="payment.property_id">
                                          <p class="mt-2">
                                            <a t-att-href="'/payment/%d' % payment.id" class="btn btn-sm btn-secondary">
                                             View Payment Details
                                            </a>
                                          </p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-if="not payment">
                    <div class="row">
                        <div class="col-12">
                            <div class="alert alert-info" role="alert">
                                No payments were found for your tenant account.
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_payment_details" name="Payment Details">
        <t t-call="portal.portal_layout">
            <div class="container mt16 o_portal_portlets">
                <nav class="breadcrumb" aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                        <li class="breadcrumb-item"><a href="/my/payment">My Payments</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <t t-esc="payment.name"/>
                        </li>
                    </ol>
                </nav>
                <h1 class="mb16"><t t-esc="payment.name"/></h1>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Property:</strong> <t t-esc="payment.property_id.name or 'N/A'"/></p>
                        <p><strong>Due Date:</strong> <t t-esc="payment.due_date"/></p>
                        <p><strong>Amount:</strong> <t t-esc="payment.amount"/></p>
                        <p><strong>Late Fees:</strong> <t t-esc="payment.late_fee or '—'"/></p>
                        <p><strong>State:</strong> <t t-esc="payment.state or '—'"/></p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_payment_menu" name="Portal My Home: My Payments" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'fa fa-home'"/>
                    <t t-set="title">My Payments</t>
                    <t t-set="text">View your payment history and details.</t>
                    <t t-set="url" t-value="'/my/payment'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'payment_count'"/>
                </t>
            </t>
        </div>
    </template>
    </odoo>