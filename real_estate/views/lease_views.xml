<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- lease Action (Links views together) -->
    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease
            </p>
        </field>
    </record>

    <!-- Lease List View (Tree) -->
    <record id="view_lease_tree" model="ir.ui.view">
        <field name="name">real_estate.lease.tree</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <tree string="leases">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="deposit_paid"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    
    <record id="ir_cron_auto_expire_leases" model="ir.cron">
        <field name="name">Real Estate: Auto Expire Leases</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_expire_leases()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    <!-- lease Form View -->
    <record id="view_lease_form" model="ir.ui.view">
        <field name="name">real_estate.lease.form</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
                <header>
                <field name="state" invisible="1"/>
                <field name="state" widget="statusbar" />
                 <button name="set_state_to_active" string="active" type="object" invisible="state == 'active'" class="oe_highlight"/>
                 <button name="set_state_to_draft" string="draft" type="object" invisible="state == 'Draft'" class="oe_highlight" />
                 <button name="action_create_maintenance" string="submit request" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                <div class="oe_button_box" name="button_box">
                  <button name="action_view_maintenance"
                   type="object"
                   class="oe_stat_button"
                   icon="fa-wrench">
                  <field name="maintenance_count"
                   widget="statinfo"
                   string="Maintenance"/>
                  </button>
                </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lease Name"/>
                        </h1>
                    </div>
                    <group string="Lease Details">
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                        </group>
                        <group>
                            <field name="monthly_rent"/>
                            <field name="deposit_paid"/>
                            <field name="user_id"/>
                            <field name="duration_months"/>
                            <field name="next_service"/>
                            <!--<field name="total_cost"/>-->
                        </group>
                        <group string="Maintenance Requests">
                            <field name="plumbing_count"/>
                            <field name="electrical_count"/>
                            <field name="air_condition_count"/>
                            <field name="appliance_count"/>
                            <field name="other_count"/>
                        </group>    
                        
                    </group>
                    <notebook>
                        <page string="Maintenance">
                            <field name="maintenance_ids">
                                <tree create="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="property_id"/>
                                    <field name="tenant_phone"/>
                                </tree>
                            </field>
                            </page>
                            <page string="Payment Information">
                            <group>
                                <group string="Payment Methods Breakdown">
                                    <field name="total_cash_amount" readonly="1"/>
                                    <field name="total_visa_amount" readonly="1"/>
                                </group>
                                <group string="Total Payments Summary">
                                    <field name="total_payment_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>                                
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

     <!-- Tenant Search View -->
    <record id="view_lease_search" model="ir.ui.view">
        <field name="name">real_estate.lease.search</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <search string="Search Leases">
                <field name="name"/>
                <field name="state"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
 
