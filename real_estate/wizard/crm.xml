<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard View -->
    <record id="create_tenant_wizard" model="ir.ui.view">
        <field name="name">create.tenant.wizard.form</field>
        <field name="model">tenant.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Tenant">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                    </group>
                    <group>
                        <field name="email"/>
                        <field name="city"/>
                        <field name="lead_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_tenant" string="Submit Request" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="create_tenant_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Tenant</field>
        <field name="res_model">tenant.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

